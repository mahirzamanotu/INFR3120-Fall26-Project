<%# This is the top part of every page. It holds the page settings, the logo and the navigation bar. %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <!-- This makes the page fit the width of phones and tablets. -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- The browser tab shows the page name and the site name. -->
  <title><%= pageTitle %> | <%= appName %></title>
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <nav class="navbar container">
      <!-- The logo and site name link back to the home page. -->
      <a class="brand" href="/">
        <img src="/images/logo.svg" alt="CampusMarket logo" width="42" height="42">
        <span><%= appName %></span>
      </a>

      <!-- This menu button only shows on small screens. main.js opens and closes the menu. -->
      <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false">&#9776;</button>

      <!-- The link for the current page gets the "active" class so it is highlighted. -->
      <ul class="nav-links">
        <li><a href="/" class="<%= activePage === 'home' ? 'active' : '' %>">Home</a></li>
        <li><a href="/listings" class="<%= activePage === 'listings' ? 'active' : '' %>">Listings</a></li>
        <li><a href="/listings/new" class="btn btn-small">+ Post a Listing</a></li>
      </ul>
    </nav>
  </header>

  <main>